<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.veterinaria.controller.ClienteController" styleClass="vista">
    <top>
        <VBox spacing="10">
            <Label styleClass="titulo" text="Clientes"/>
            <HBox spacing="10">
                <TextField fx:id="campoBusqueda" promptText="Buscar por DNI, nombre o apellido..."
                           onAction="#buscar" HBox.hgrow="ALWAYS"/>
                <Button text="Buscar" onAction="#buscar"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Nuevo cliente" onAction="#nuevoCliente" styleClass="boton-primario"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDni" text="DNI"/>
                <TableColumn fx:id="colNombre" text="Nombre"/>
                <TableColumn fx:id="colApellido" text="Apellido"/>
                <TableColumn fx:id="colTelefono" text="Telefono"/>
                <TableColumn fx:id="colEmail" text="Email"/>
                <TableColumn fx:id="colMascotas" text="Mascotas"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10" styleClass="barra-acciones">
            <Button text="Modificar" onAction="#modificarCliente"/>
            <Button text="Eliminar" onAction="#eliminarCliente"/>
        </HBox>
    </bottom>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
</BorderPane>
